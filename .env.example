# Copy to .env (never commit it). Real environment variables take precedence over .env.
MCA_PROJECT_ID=minimal-coding-agent
MCA_IMAGE=minimal-coding-agent-sandbox:step2
MCA_HOST=127.0.0.1
MCA_PORT=8000

# Any OpenAI Chat Completions-compatible endpoint that supports tool calling.
LLM_API_KEY=replace-me
LLM_BASE_URL=https://provider.example/v1
LLM_MODEL=replace-with-verified-model
# Optional provider differences:
# LLM_TOKEN_PARAM=max_tokens            # or max_completion_tokens (newer OpenAI models)
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_PARALLEL_TOOL_CALLS=false         # sends parallel_tool_calls=false; use "omit" if the provider rejects it
